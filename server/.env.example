# Базові налаштування SvitloBot Monitor.
# На сервері цей файл створює GitHub Action із секретів репозиторію (див. README).
# Для ручного запуску: cp .env.example .env і заповніть значення.
# Зміни з веб-панелі пишуться не сюди, а в data/.env.override (він має пріоритет).

# Вхід у веб-панель. ОБОВ'ЯЗКОВО задайте надійний пароль!
PANEL_USERNAME='admin'
PANEL_PASSWORD='змініть-мене'

# Ключ каналу Світлобота (channel_key)
SVITLOBOT_TOKEN=''

# Зовнішній IP або домен об'єкта (роутера)
TARGET_IP=''

# Telegram: токен бота та ID каналу (необов'язково)
TELEGRAM_BOT_TOKEN=''
SVITLOBOT_CHANNEL=''

# Режим роботи ESP32: upnp (проброс порту, типово) або push (ESP32 сам стукає на сервер)
# DEVICE_MODE='upnp'
# Ключ ESP32: доступ до сторінки (upnp) або підпис стуків (push, обов'язковий)
# ESP_KEY=''

# Необов'язкові параметри (інакше — типові або задані в панелі)
# ESP_PORTS='18080,18081,18082,18083,18084'
# PUSH_TIMEOUT='60'
# CHECK_INTERVAL='20'
# CONFIRM_COUNT='3'
# REACHABILITY_METHOD='icmp'
# TCP_PORT='443'
# UNKNOWN_POLICY='keep_last'

# Параметри контейнера (читає Docker Compose)
WEB_PORT='8080'
WEB_BIND='0.0.0.0'
HEARTBEAT_PORT='8081'
HEARTBEAT_BIND='0.0.0.0'
TZ='Europe/Kyiv'
LOG_LEVEL='INFO'
